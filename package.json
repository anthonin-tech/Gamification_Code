{
  "name": "codequest",
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:backend": "set \"MONGODB_REQUIRED=false\" && node --watch backend/index.js",
    "dev:backend:strict": "node --watch backend/index.js",
    "start:backend": "node backend/index.js",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "type-check": "vue-tsc --noEmit"
  },
  "dependencies": {
    "mongoose": "^8.19.1",
    "node-cron": "^4.2.1",
    "rss-parser": "^3.13.0",
    "vue": "^3.4.0",
    "vue-router": "^4.2.0",
    "pinia": "^2.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "^1.8.0"
  }
}
